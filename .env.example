# TradeFirewall — copy to `.env.local` (never commit real secrets)

# --- SoSoValue (required for live risk reports) ---
# Get a key from https://sosovalue.com/developer/dashboard
# Official OpenAPI: https://openapi.sosovalue.com/openapi/v1 (header: x-soso-api-key)
SOSOVALUE_API_KEY=
# Optional override (default is the public OpenAPI base URL)
# SOSOVALUE_API_BASE_URL=https://openapi.sosovalue.com/openapi/v1

# --- SoDEX public market data (no signing key required) ---
# Default: testnet public REST; Mainnet execution has a separate explicit opt-in.
SODEX_USE_TESTNET=true
SODEX_TESTNET_SPOT_URL=https://testnet-gw.sodex.dev/api/v1/spot
# SODEX_TESTNET_RPC_URL=https://testnet.valuechain.xyz

# Optional testnet builder attribution for eligible spot sell orders.
# 50 means a maximum fee of 0.05%; rates are integers in tenths of a basis point.
# Network-specific values take precedence over the legacy generic testnet values.
SODEX_TESTNET_BUILDER_ID=
SODEX_TESTNET_BUILDER_FEE_RATE=50
SODEX_TESTNET_BUILDER_OWNER_ADDRESS=
# Legacy testnet aliases:
SODEX_BUILDER_ID=
SODEX_BUILDER_FEE_RATE=50
SODEX_BUILDER_OWNER_ADDRESS=

# Mainnet settings are separate. Mainnet order execution requires BOTH opt-ins below.
# Keep SODEX_USE_TESTNET=true for the default testnet network.
# SODEX_USE_TESTNET=false
# SODEX_ENABLE_MAINNET_TRADING=true
# SODEX_MAINNET_SPOT_URL=https://mainnet-gw.sodex.dev/api/v1/spot
# SODEX_MAINNET_RPC_URL=https://mainnet.valuechain.xyz
# SODEX_MAINNET_BUILDER_ID=
# SODEX_MAINNET_BUILDER_FEE_RATE=50
# SODEX_MAINNET_BUILDER_OWNER_ADDRESS=

# Legacy: if you still have NEXT_PUBLIC_SOSOVALUE_API_KEY it is read as a fallback,
# but prefer SOSOVALUE_API_KEY so the key is server-only.
